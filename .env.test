# Variables d'environnement pour le mode test (GitHub CI)
# Ce fichier est commité — ne pas y mettre de secrets réels

# Active le client Prisma mock (JSON) à la place de MySQL
USE_MOCK_DB=true

# DATABASE_URL factice — non utilisée en mode mock
DATABASE_URL="mysql://mock:mock@localhost:3306/mock_db"

# SMTP factice — les emails ne sont pas envoyés en mode mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@entreprise.com
SMTP_PASS=test
SMTP_SECURE=false
FROM_EMAIL=test@entreprise.com

# Environnement Next.js
NODE_ENV=test
